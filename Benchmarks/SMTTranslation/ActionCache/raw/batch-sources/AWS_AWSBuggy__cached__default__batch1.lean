module

public import Veil

set_option Elab.async false
section

open Lean Elab Tactic Meta Veil

meta def symbolicBenchEvent (event phase status : String) (elapsed : Nat := 0)
    (extra : List (String × Json) := []) : CoreM Unit := do
  let j := Json.mkObj ([
    ("event", toJson event), ("phase", toJson phase), ("status", toJson status),
    ("elapsed_ms", toJson elapsed), ("mono_ms", toJson (← IO.monoMsNow))] ++ extra)
  IO.FS.withFile (System.FilePath.mk ((← getOptions).get `symbolicBench.eventPath "")) .append fun h => h.putStrLn j.compress

meta partial def symbolicBenchIntroData (goal : MVarId) : MetaM MVarId := goal.withContext do
  let target ← instantiateMVars (← goal.getType)
  let .forallE _ domain _ _ := target.consumeMData | return goal
  if ← isProp domain then return goal
  let (_, next) ← withOptions (fun opts => opts.setBool `tactic.hygienic false) goal.intro1
  symbolicBenchIntroData next

elab "symbolic_bench_intro_data" : tactic => do
  liftMetaTactic1 fun goal => return some (← symbolicBenchIntroData goal)

elab "symbolic_bench_phase " label:str t:tactic : tactic => do
  if (← getGoals).isEmpty then
    symbolicBenchEvent "stage" label.getString "skipped_goal_closed"
  else
    symbolicBenchEvent "stage" label.getString "begin"
    let start ← IO.monoMsNow
    let hbStart ← IO.getNumHeartbeats
    try
      withoutRecover <| evalTactic t
      symbolicBenchEvent "stage" label.getString "complete" ((← IO.monoMsNow) - start)
        [("heartbeats", toJson ((← IO.getNumHeartbeats) - hbStart))]
    catch ex =>
      symbolicBenchEvent "stage" label.getString "failed" ((← IO.monoMsNow) - start)
        [("heartbeats", toJson ((← IO.getNumHeartbeats) - hbStart)), ("error", toJson (← ex.toMessageData.toString))]
      throw ex

meta def symbolicBenchMetaPhase {α : Type} (label : String) (computation : MetaM α) : MetaM α := do
  symbolicBenchEvent "stage" label "begin"
  let start ← IO.monoMsNow
  let hbStart ← IO.getNumHeartbeats
  try
    let value ← computation
    symbolicBenchEvent "stage" label "complete" ((← IO.monoMsNow) - start)
      [("heartbeats", toJson ((← IO.getNumHeartbeats) - hbStart))]
    return value
  catch ex =>
    symbolicBenchEvent "stage" label "failed" ((← IO.monoMsNow) - start)
      [("heartbeats", toJson ((← IO.getNumHeartbeats) - hbStart)), ("error", toJson (← ex.toMessageData.toString))]
    throw ex

meta def symbolicBenchTacticPhase {α : Type} (label : String) (computation : TacticM α) : TacticM α := do
  symbolicBenchEvent "stage" label "begin"
  let start ← IO.monoMsNow
  let hbStart ← IO.getNumHeartbeats
  try
    let value ← computation
    symbolicBenchEvent "stage" label "complete" ((← IO.monoMsNow) - start)
      [("heartbeats", toJson ((← IO.getNumHeartbeats) - hbStart))]
    return value
  catch ex =>
    symbolicBenchEvent "stage" label "failed" ((← IO.monoMsNow) - start)
      [("heartbeats", toJson ((← IO.getNumHeartbeats) - hbStart)), ("error", toJson (← ex.toMessageData.toString))]
    throw ex

elab "symbolic_bench_extract " eventPath:str path:str t:tactic : tactic => do
  withOptions (fun opts => opts.set `symbolicBench.eventPath eventPath.getString) do
    symbolicBenchEvent "pipeline" "pipeline" "begin" 0 [
      ("maxHeartbeats", toJson (maxHeartbeats.get (← getOptions))),
      ("maxRecDepth", toJson (maxRecDepth.get (← getOptions)))]
    let start ← IO.monoMsNow
    withoutRecover <| evalTactic t
    symbolicBenchEvent "milestone" "preprocessing" "complete" ((← IO.monoMsNow) - start)
    if (← getGoals).isEmpty then
      symbolicBenchEvent "pipeline" "pipeline" "discharged" ((← IO.monoMsNow) - start)
    else
      Veil.withBackwardsCompatibility <| withMainContext do
        let (mv, hs) ← symbolicBenchTacticPhase "cleanup" do
          let hs := (← getFVarIds (← Veil.getPropsInContext)).map Expr.fvar
          let goal ← getMainGoal
          let mv := (← Meta.mkFreshExprMVar (← goal.getType)).mvarId!
          let mv ← mv.cleanup (← hs.foldlM (fun s h => return (← (Expr.collectFVars h).run s).snd) {}).fvarIds
          return (mv, hs)
        let mut mv := mv
        let mut hs := hs
        let steps : Array (String × (MVarId → Array Expr → MetaM Smt.Preprocess.Result)) := #[
          ("pushHints", Smt.Preprocess.pushHintsToCtx),
          ("smt-intros", Smt.Preprocess.intros),
          ("negateGoal", Smt.Preprocess.negateGoal),
          ("normalize", Smt.Preprocess.normalize),
          ("embedding", Smt.Preprocess.embeddingWithConfig { embedBool := false })]
        for (label, step) in steps do
          let result ← symbolicBenchMetaPhase label <| mv.withContext <| step mv hs
          mv := result.mv
          hs := result.hs
        let cmds ← symbolicBenchMetaPhase "translate" <| mv.withContext do
          let (fvNames, _) ← Smt.genUniqueFVarNames
          Smt.prepareSmtQuery hs.toList fvNames
        let query ← symbolicBenchMetaPhase "serialize" do
          let query := Smt.Translate.Command.cmdsAsQuery (.setLogic "ALL" :: cmds ++ [.checkSat])
          IO.FS.writeFile path.getString query
          return query
        symbolicBenchEvent "pipeline" "pipeline" "complete" ((← IO.monoMsNow) - start)
          [("bytes", toJson query.utf8ByteSize), ("commands", toJson cmds.length)]
    -- Deliberately abandon the measurement declaration; no theorem is admitted.
    throwError "SYMBOLIC_BMC_EXTRACTION_COMPLETE: query extraction only; no proof claimed"

end
set_option veil.experimental.bmcCache true

veil module AWSDnsRace

macro "PlanId" : term => `(term|Fin 10)
macro "NoPlan" : term => `(term|(0 : PlanId))

type Enactor

enum EnactorPC = {
  Receive,
  Apply,
  Cleanup,
  RemoveActiveDNS
}

-- maximum number of plans (bounded model checking)
immutable individual max_plan : PlanId
-- number of plan generations after which a plan can be deleted
immutable individual plan_age_threshold : PlanId

/- Route53 / regional endpoint state

  `current_plan` is the plan currently serving the regional endpoint.
  `dns_valid` says whether the endpoint has IP addresses.
-/
individual current_plan : PlanId
individual dns_valid : Bool

/- Planner / plan lifecycle state -/
individual latest_plan : PlanId           -- last plan generated by the Planner
individual highest_plan_applied : PlanId  -- highest version ever applied
relation plan_deleted : PlanId → Bool     -- set of deleted plans
relation plan_queue : PlanId → Bool       -- set of plans awaiting enactment

/-/ Enactor state -/
function enactor_processing : Enactor → PlanId        -- plan being processed by the Enactor
function enactor_pc : Enactor → EnactorPC
-- snapshot of current_plan taken before applying new plan
function enactor_snapshot_current : Enactor → PlanId
function cleanup_cursor : Enactor → PlanId            -- old plan being considered for cleanup

after_init {
  current_plan := NoPlan
  dns_valid := true
  latest_plan := NoPlan
  highest_plan_applied := NoPlan
  plan_deleted P := false
  plan_queue P := false
  enactor_processing E := NoPlan
  enactor_snapshot_current E := NoPlan
  cleanup_cursor E := NoPlan
  enactor_pc E := Receive
}

procedure EnactorGoToReceive (self : Enactor) {
  cleanup_cursor self := NoPlan
  enactor_pc self := Receive
}

procedure EnactorGoToCleanup (self : Enactor) {
  cleanup_cursor self := (1 : PlanId)
  enactor_pc self := Cleanup
}


action PlannerNewPlan {
  require latest_plan < max_plan
  let new_plan := latest_plan + 1
  require new_plan ≤ max_plan
  latest_plan := new_plan
  plan_queue new_plan := true
}

action EnactorReceive (self : Enactor) {
  require ∃ (p : PlanId), plan_queue p
  require enactor_pc self = Receive

  let p :| plan_queue p = true ∧ ∀ (p'), plan_queue p' = true → p ≤ p'
  enactor_processing self := p
  enactor_pc self := Apply
  plan_queue p := false

  -- BUG: the snapshot is taken here, rather than right before the apply
  -- step. This allows a delayed Enactor to have a stale snapshot that passes
  -- the newer check, but then fails at the apply step after current_plan has
  -- been rolled back by another Enactor.
  enactor_snapshot_current self := current_plan
}

action EnactorApply (self : Enactor) {
  require enactor_pc self = Apply
  let plan_to_apply := enactor_processing self
  let snapshot := enactor_snapshot_current self

  let is_newer := (plan_to_apply > snapshot) ∨ (snapshot = NoPlan)
  let is_deleted := plan_deleted plan_to_apply
  if is_newer ∧ !is_deleted then
    current_plan := plan_to_apply
    dns_valid := true
    if plan_to_apply > highest_plan_applied then
      highest_plan_applied := plan_to_apply
    EnactorGoToCleanup self
  else
    EnactorGoToReceive self
}

action EnactorCleanupScanOne (self : Enactor) {
  require enactor_pc self = Cleanup

  let applied_plan := enactor_processing self
  let p := cleanup_cursor self

  if p < applied_plan then
    if (p ≠ NoPlan) ∧ (applied_plan - p ≥ plan_age_threshold) ∧ (!plan_deleted p) then
      plan_deleted p := true
      if current_plan = p then
        enactor_pc self := RemoveActiveDNS
    cleanup_cursor self := p + 1
  else
    EnactorGoToReceive self
}

action EnactorRemoveDNSRecords (self : Enactor) {
  require enactor_pc self = RemoveActiveDNS
  dns_valid := false
  EnactorGoToReceive self
}

safety [DnsConsistent] dns_valid = true


