                                                                    (congrArg HAdd.hAdd (Int.toNat_of_nonneg a✝⁴)) 1)))
                                                              st1.tpos.isLt⟩ ∧
                                                        st0.tcolor = st1.tcolor))))))))
                                      (congr
                                        (congrArg And
                                          (congrArg
                                            (And
                                              (⟨f.toNat,
                                                  Eq.substr
                                                    (Eq.trans Int.ofNat_lt._simp_2
                                                      (congr (congrArg LT.lt (Int.toNat_of_nonneg a))
                                                        (congrFun' (congrArg HAdd.hAdd (Int.toNat_of_nonneg a✝⁴)) 1)))
                                                    st1.tpos.isLt⟩ =
                                                0))
                                            (congrArg (And (st1.tcolor = Color_Enum.white))
                                              (congrArg (And (st1.colormap 0 = Color_Enum.white))
                                                (Eq.trans Bool.ne_eq_true._simp_1
                                                  (congr (congrArg Ne decide_eq_true_iff._simp_2)
                                                    Bool.true_eq_true._simp_1))))))
                                        (congrArg Exists (funext fun x => decide_eq_true_iff._simp_2)))))))
                              (Eq.refl False)))))))))
